# Compiled output
/dist
/node_modules

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.eslintcache

# OS files
.DS_Store

# Test coverage
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
.cursor/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Docker
docker-compose.yml

# Env files
.env
.env.*
.env.development
.env.production
.env.test
# Sem ponto: variante antiga que chegou a ser commitada com segredos.
env
!env.development.example
!env.production.example

# Chaves JWT/TLS: nunca commitar (usar JWT_PRIVATE_KEY no .env*)
src/middleware/*.key
src/middleware/*.key.pub
*.pem

# SSH / OCI private keys (local only — never commit)
/keys/*
!/keys/.gitkeep

# Logs directory with keep
/logs/*
!/logs/.gitkeep

# Local object storage (STORAGE_TYPE=local)
/uploads/*
!/uploads/.gitkeep

# Lock files (keep only the one you use)
yarn.lock
pnpm-lock.yaml