# Copie para .env.development: cp env.development.example .env.development

NODE_ENV=development
NODE_PORT=3000
LOG_LEVEL=debug

# Front Next.js (links de reset de senha)
FRONTEND_URL=http://localhost:3001

# Banco local
DB_USERNAME=designflix_user
DB_PASSWORD=123456
DB_DATABASE=designflix
DB_HOST=localhost
DB_PORT=3306

# Mailpit local (docker run -p 8025:8025 -p 1025:1025 axllent/mailpit)
EMAIL_USE_MAILPIT=true
EMAIL_HOST_SMTP=localhost
EMAIL_PORT_SMTP=1025
EMAIL_FROM=dev@designflix.local

# Produção/staging: comente Mailpit e use SMTP real
# EMAIL_HOST_SMTP=smtp.hostinger.com
# EMAIL_PORT_SMTP=465
# EMAIL_USER_SMTP=seu@email.com
# EMAIL_PASS_SMTP=sua-senha

API_URL=http://localhost:3000

# Upload local (sem S3)
STORAGE_TYPE=local
