# Copie para .env.development: cp env.development.example .env.development

NODE_ENV=development
NODE_PORT=3000
LOG_LEVEL=debug
VERSION_API=1.1.4

# Front Next.js (links de reset de senha)
FRONTEND_URL=http://localhost:3001
# Painel admin local (links de redefinição de senha do admin)
ADMIN_PANEL_URL=http://localhost:3002

# Banco local
DB_USERNAME=designflix_user
DB_PASSWORD=123456
DB_DATABASE=designflix
DB_HOST=localhost
DB_PORT=3306

# Mailpit local (docker run -p 8025:8025 -p 1025:1025 axllent/mailpit)
EMAIL_USE_MAILPIT=true
EMAIL_HOST_SMTP=localhost
EMAIL_PORT_SMTP=1025
EMAIL_FROM=dev@designflix.local

# Produção NÃO usa este arquivo: SMTP Brevo fica no .env.production (gitignored).
# Modelo: env.production.example — docs/email-smtp-brevo.md

API_URL=http://localhost:3000

# JWT (RS256) — opcional em dev: sem ela a API usa chave efêmera (tokens caem ao reiniciar).
# Gere uma chave SUA (nunca commitar) — ver docs/deploy-oracle.md:
# JWT_PRIVATE_KEY="<PEM da chave privada RSA em uma linha, quebras como \n>"

# Upload local (sem S3)
STORAGE_TYPE=local
