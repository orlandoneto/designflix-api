# Produção (VM Oracle designflix-api) — MODELO com placeholders.
#
#   cp env.production.example .env.production   # .env.production é gitignored
#
# O deploy (`npm run deploy:oracle`, scripts/deploy-oracle.ps1) envia o
# .env.production local como /home/opc/designflix-api/.env (backup + chmod 600).
# NUNCA commite valores reais (repo público). Docs: docs/deploy-oracle.md,
# docs/email-smtp-brevo.md.

NODE_ENV=production
NODE_PORT=4000
PORT=4000
LOG_LEVEL=info
# O deploy sobrescreve com a versão do package.json
VERSION_API=1.1.1

# MySQL local da VM
DB_USERNAME=<usuario-mysql>
DB_PASSWORD=<senha-mysql>
DB_DATABASE=designflix
DB_HOST=127.0.0.1
DB_PORT=3306

API_URL=https://api.ongraph.com.br
FRONTEND_URLS=https://ongraph.com.br,https://www.ongraph.com.br,https://admin.ongraph.com.br
# Painel admin: base dos links de redefinição de senha do admin (POST /admin/reset-password)
ADMIN_PANEL_URL=https://admin.ongraph.com.br

# Chave RSA 4096 dos JWT (RS256) — OBRIGATÓRIA. PEM em UMA linha, \n escapado, entre aspas.
# Gerar: ver docs/deploy-oracle.md (seção "Chave JWT"). Trocar = todos deslogam.
JWT_PRIVATE_KEY="<PEM da chave privada RSA 4096 em uma linha, quebras como \n>"
# Legado (não usados pelo código atual)
JWT_SECRET=<gerar-segredo-longo>
JWT_REFRESH_SECRET=<gerar-segredo-longo>

# Produção: SEMPRE r2 (rule vps-always-free-monitor-r2)
STORAGE_TYPE=r2

CATALOG_SEARCH_PROVIDER=auto
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=<meili-master-key>
MEILI_INDEX=catalog_items

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

SKIP_RECAPTCHA=true

ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=<asaas-webhook-token>
ASAAS_API_KEY=<asaas-api-key>

# Cloudflare R2
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=<bucket>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>

# Legado S3 (mantido por compatibilidade)
AWS_BUCKET_NAME=<bucket>
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_REGION=sa-east-1

# E-mail transacional — Brevo SMTP (docs/email-smtp-brevo.md)
# Porta 587 = STARTTLS (secure=false). A Oracle bloqueia a porta 25.
# O IP público do servidor precisa estar em Brevo > Security > Authorized IPs.
EMAIL_USE_MAILPIT=false
EMAIL_HOST_SMTP=smtp-relay.brevo.com
EMAIL_PORT_SMTP=587
EMAIL_USER_SMTP=<login-smtp>@smtp-brevo.com
EMAIL_PASS_SMTP=<chave-smtp-brevo-designflix-vm>
# Remetente verificado no Brevo; domínio ongraph.com.br autenticado (DKIM brevo1/brevo2 + SPF + DMARC).
EMAIL_FROM="Designflix <contato@ongraph.com.br>"
