    "cors": "^2.8.5",
    "dotenv": "^8.6.0",
    "express": "^4.17.1",
    "fs": "^0.0.1-security",
    "geocoder": "^0.1.0",
    "haversine": "^1.1.1",
    "helmet": "^4.4.1",
    "jsonwebtoken": "^8.5.1",
    "md5": "^2.3.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.2",
    "multer-s3": "^2.9.0",
