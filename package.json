{
  "name": "flixdesign-api",
  "private": true,
  "version": "1.0.0",
  "description": "API Design Flix made on Node.js",
  "main": "src/main.js",
  "scripts": {
    "minify": "node scripts/minify.js",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:server": "cross-env NODE_ENV=test LOG_LEVEL=verbose node scripts/setEnv.js && cross-env NODE_ENV=test node src/main.js",
    "dev": "node scripts/dev-with-mailpit.js",
    "dev:api": "cross-env NODE_ENV=development LOG_LEVEL=debug node scripts/setEnv.js && cross-env NODE_ENV=development nodemon src/main.js",
    "dev:local": "node scripts/dev-with-mailpit.js",
    "mailpit:up": "node scripts/mailpit.js up",
    "mailpit:down": "node scripts/mailpit.js down",
    "mailpit:status": "node scripts/mailpit.js status",
    "ngrok:up": "node scripts/ngrok.js up",
    "ngrok:down": "node scripts/ngrok.js down",
    "ngrok:status": "node scripts/ngrok.js status",
    "asaas:check": "node scripts/asaas-smoke.js",
    "asaas:webhook": "node scripts/asaas-webhook-sim.js",
    "meili:up": "node scripts/meilisearch.js up",
    "meili:down": "node scripts/meilisearch.js down",
    "meili:status": "node scripts/meilisearch.js status",
    "catalog:reindex": "node scripts/catalog-reindex.js",
    "start": "cross-env NODE_ENV=production LOG_LEVEL=info node scripts/setEnv.js && cross-env NODE_ENV=production node src/main.js",
    "build-stg": "node scripts/setEnv.js development && babel src --out-dir dist && npm run minify",
    "build-prd": "node scripts/setEnv.js production && babel src --out-dir dist && npm run minify",
    "deploy-stg": "pm2 deploy ecosystem.development.config.js staging",
    "deploy-prd": "pm2 deploy ecosystem.production.config.js production",
    "deploy": "yarn run deploy-stg && yarn run deploy-prd",
    "copy-keys": "cp ./src/middleware/private.key ./dist/middleware/",
    "build": "babel src --out-dir dist && npm run copy-keys",
    "migrate": "node scripts/setEnv.js development && npx sequelize-cli db:migrate",
    "migrate:development": "node scripts/setEnv.js development && npx sequelize-cli db:migrate",
    "migrate:production": "node scripts/setEnv.js production && npx sequelize-cli db:migrate",
    "db:setup": "node scripts/setEnv.js development && node scripts/setupLocalDb.js && node scripts/syncModels.js && node scripts/markMigrations.js"
  },
  "author": "FlixDesign",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@scarf/scarf": "^1.4.0",
    "7zip-bin": "^5.2.0",
    "aws-sdk": "2.1691.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.0.1",
    "body-parser": "^1.19.0",
    "chalk": "4.1.2",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "express": "^4.17.1",
    "geocoder": "^0.1.0",
    "haversine": "^1.1.1",
    "helmet": "^4.4.1",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "md5": "^2.3.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.4",
    "multer-s3": "^2.10.0",
    "mysql2": "^3.11.3",
    "node-cron": "^3.0.3",
    "node-schedule": "^2.0.0",
    "nodemailer": "^6.6.2",
    "nodemailer-handlebars": "^1.0.0",
    "object-inspect": "^1.13.3",
    "path": "^0.12.7",
    "randomstring": "^1.3.0",
    "sequelize": "^6.5.0",
    "sharp": "^0.33.5",
    "stripe": "^16.12.0",
    "tar": "^7.4.3",
    "unzipper": "^0.12.3",
    "uuid": "^10.0.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-cli": "^6.26.0",
    "babel-loader": "^9.2.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "esbuild": "^0.24.0",
    "eslint": "^7.21.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-plugin-import": "^2.22.1",
    "glob": "^10.4.5",
    "jest": "^29.7.0",
    "nodemon": "^2.0.22",
    "pm2-deploy": "^1.0.2",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0",
    "terser": "^5.36.0",
    "uglify-js": "^3.19.3"
  },
  "license": "MIT"
}
