{
  "name": "designflix-api",
  "private": true,
  "version": "1.0.0",
  "description": "API Design Flix made on Node.js",
  "main": "src/main.js",
  "scripts": {
    "minify": "node scripts/minify.js",
    "test": "node scripts/setEnv.js test && nodemon src/main.js",
    "dev": "node scripts/setEnv.js development && nodemon src/main.js",
    "start": "node scripts/setEnv.js production && node src/main.js",
    "build-stg": "node scripts/setEnv.js development && babel src --out-dir dist && npm run minify",
    "build-prd": "node scripts/setEnv.js production && babel src --out-dir dist && npm run minify",
    "migrate": "cd src && npx sequelize-cli db:migrate && cd ..",
    "deploy-stg": "pm2 deploy ecosystem.development.config.js staging",
    "deploy-prd": "pm2 deploy ecosystem.production.config.js production",
    "deploy": "deploy-stg && deploy-prd",
    "copy-keys": "cp ./src/middleware/private.key ./dist/middleware/",
    "build": "babel src --out-dir dist && npm run copy-keys"
  },
  "author": "DesignFlix",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@scarf/scarf": "^1.4.0",
    "aws-sdk": "2.1691.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.0.1",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "express": "^4.17.1",
    "geocoder": "^0.1.0",
    "haversine": "^1.1.1",
    "helmet": "^4.4.1",
    "jsonwebtoken": "^9.0.2",
    "md5": "^2.3.0",
    "mercadopago": "^2.0.15",
    "morgan": "^1.10.0",
    "multer": "^1.4.4",
    "multer-s3": "^2.10.0",
    "mysql2": "^3.11.3",
    "node-schedule": "^2.0.0",
    "nodemailer": "^6.6.2",
    "nodemailer-handlebars": "^1.0.0",
    "object-inspect": "^1.13.3",
    "path": "^0.12.7",
    "randomstring": "^1.3.0",
    "sequelize": "^6.5.0",
    "sharp": "^0.33.5",
    "stripe": "^16.12.0",
    "swagger-jsdoc": "^6.1.0",
    "swagger-ui-express": "^4.1.6",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-cli": "^6.26.0",
    "babel-loader": "^9.2.1",
    "dotenv": "^16.4.5",
    "esbuild": "^0.24.0",
    "eslint": "^7.21.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-plugin-import": "^2.22.1",
    "glob": "^10.4.5",
    "nodemon": "^2.0.22",
    "pm2-deploy": "^1.0.2",
    "sequelize-cli": "^6.6.2",
    "terser": "^5.36.0",
    "uglify-js": "^3.19.3"
  },
  "license": "MIT"
}